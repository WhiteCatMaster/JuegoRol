# Copy this file to ".env" and fill in real values. NEVER commit .env.

# Dominios (sin protocolo, sin barra final).
# Caddy enrutará DOMAIN -> frontend y api.DOMAIN -> backend.
DOMAIN=tudominio.com
ACME_EMAIL=tu-email@dominio.com

# MySQL
MYSQL_DATABASE=juegorol_db
MYSQL_USER=equipo10
MYSQL_PASSWORD=cambia-esto
MYSQL_ROOT_PASSWORD=cambia-esto-tambien

# Spring (deben coincidir con los de MySQL)
SPRING_DATASOURCE_USERNAME=equipo10
SPRING_DATASOURCE_PASSWORD=cambia-esto

# Grafana (opcional: por defecto admin/admin la primera vez)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambia-esto
